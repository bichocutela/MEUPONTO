# Copy to secrets.properties (ignored by Git) and fill locally.
# Never commit the real file.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local/dev only. Do NOT ship a Gemini API key inside the production APK.
GEMINI_API_KEY=

# Future backend/proxy endpoint for Gemini in production.
GEMINI_PROXY_URL=
